---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  count?: string;
}

const { eyebrow, title, intro, count } = Astro.props;
---

<header class="page-header">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {intro && <p class="lede page-header__intro">{intro}</p>}
    {count && <p class="page-header__count">{count}</p>}
  </div>
</header>

<style>
  .page-header {
    padding-block: clamp(2.75rem, 7vw, 5.5rem) clamp(1.75rem, 4vw, 3rem);
  }

  .page-header__intro {
    margin-top: 1.25rem;
  }

  .page-header__count {
    margin-top: 1.75rem;
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
