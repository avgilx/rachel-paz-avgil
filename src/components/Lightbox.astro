---
// תצוגה מוגדלת של עבודה. מופע יחיד בעמוד; מקבל את הנתונים מכפתורי הגלריה.
---

<dialog class="lb" data-lightbox aria-label="תצוגת עבודה מוגדלת">
  <div class="lb__shell">
    <div class="lb__bar">
      <p class="lb__counter" data-lb-counter aria-live="polite"></p>
      <button type="button" class="lb__close" data-lb-close aria-label="סגירת התצוגה">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" fill="none">
          <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.4" />
        </svg>
      </button>
    </div>

    <div class="lb__stage">
      <button
        type="button"
        class="lb__nav lb__nav--prev"
        data-lb-prev
        aria-label="לעבודה הקודמת"
      >
        <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true" fill="none">
          <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
        </svg>
      </button>

      <figure class="lb__figure">
        <span class="lb__imgwrap">
          <img data-lb-image alt="" />
        </span>
        <figcaption class="lb__caption">
          <span class="lb__title" data-lb-title></span>
          <span class="lb__text" data-lb-text aria-hidden="true"></span>
          <span class="lb__details" data-lb-details></span>
        </figcaption>
      </figure>

      <button
        type="button"
        class="lb__nav lb__nav--next"
        data-lb-next
        aria-label="לעבודה הבאה"
      >
        <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true" fill="none">
          <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</dialog>

<style>
  .lb {
    padding: 0;
    border: 0;
    width: 100%;
    max-width: 100vw;
    height: 100%;
    max-height: 100dvh;
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
  }

  .lb::backdrop {
    background: rgba(28, 24, 20, 0.55);
    backdrop-filter: blur(3px);
  }

  .lb[open] {
    animation: lb-in 0.3s var(--ease);
  }

  @keyframes lb-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .lb__shell {
    height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .lb__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem clamp(1rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--line-soft);
  }

  .lb__counter {
    margin: 0;
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .lb__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }

  .lb__close:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .lb__stage {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1.5rem);
    padding: clamp(1rem, 3vw, 2.25rem) clamp(0.5rem, 3vw, 2.5rem)
      clamp(1.5rem, 3vw, 2.5rem);
    min-height: 0;
  }

  .lb__nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(2.75rem, 6vw, 3.5rem);
    height: clamp(2.75rem, 6vw, 3.5rem);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }

  .lb__nav:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .lb__figure {
    margin: 0;
    min-height: 0;
    height: 100%;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    justify-items: center;
    gap: clamp(0.9rem, 2vw, 1.5rem);
  }

  .lb__imgwrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .lb__figure img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: var(--shadow-lift);
  }

  .lb__caption {
    display: grid;
    gap: 0.4rem;
    max-width: 58ch;
    text-align: center;
    font-size: var(--step--1);
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .lb__title:not(:empty) {
    font-family: 'Frank Ruhl Libre', Georgia, serif;
    font-size: var(--step-1);
    color: var(--ink);
    line-height: 1.3;
  }

  .lb__details:not(:empty) {
    color: var(--ink-muted);
    letter-spacing: 0.06em;
  }

  @media (max-width: 720px) {
    .lb__stage {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
      row-gap: 1rem;
    }

    .lb__figure {
      grid-row: 1;
      grid-column: 1 / -1;
    }

    .lb__nav--prev {
      grid-row: 2;
      grid-column: 1;
      justify-self: start;
    }

    .lb__nav--next {
      grid-row: 2;
      grid-column: 2;
      justify-self: end;
    }

    .lb__caption {
      font-size: 0.85rem;
      line-height: 1.6;
      max-height: 30dvh;
      overflow-y: auto;
    }
  }
</style>

<script>
  type Item = {
    button: HTMLButtonElement;
    src: string;
    width: number;
    height: number;
    alt: string;
    caption: string;
    title: string;
    details: string[];
  };

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  if (dialog && gallery) {
    const image = dialog.querySelector<HTMLImageElement>('[data-lb-image]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-lb-counter]')!;
    const titleEl = dialog.querySelector<HTMLElement>('[data-lb-title]')!;
    const textEl = dialog.querySelector<HTMLElement>('[data-lb-text]')!;
    const detailsEl = dialog.querySelector<HTMLElement>('[data-lb-details]')!;
    const prevBtn = dialog.querySelector<HTMLButtonElement>('[data-lb-prev]')!;
    const nextBtn = dialog.querySelector<HTMLButtonElement>('[data-lb-next]')!;
    const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-lb-close]')!;

    const items: Item[] = [...gallery.querySelectorAll<HTMLButtonElement>('.tile')].map(
      (button) => ({
        button,
        src: button.dataset.full!,
        width: Number(button.dataset.width),
        height: Number(button.dataset.height),
        alt: button.dataset.alt ?? '',
        caption: button.dataset.caption ?? '',
        title: button.dataset.title ?? '',
        details: JSON.parse(button.dataset.details || '[]') as string[],
      }),
    );

    let current = 0;
    let opener: HTMLElement | null = null;
    const single = items.length < 2;
    prevBtn.hidden = single;
    nextBtn.hidden = single;

    const preload = (index: number) => {
      const item = items[(index + items.length) % items.length];
      if (item) new Image().src = item.src;
    };

    const show = (index: number) => {
      current = (index + items.length) % items.length;
      const item = items[current];
      image.src = item.src;
      image.alt = item.alt;
      image.width = item.width;
      image.height = item.height;
      titleEl.textContent = item.title;
      textEl.textContent = item.caption;
      detailsEl.textContent = item.details.join(' · ');
      counter.textContent = `${current + 1} מתוך ${items.length}`;
      if (!single) {
        preload(current + 1);
        preload(current - 1);
      }
    };

    const open = (index: number) => {
      opener = items[index]?.button ?? null;
      show(index);
      if (!dialog.open) dialog.showModal();
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    };

    const close = () => {
      if (dialog.open) dialog.close();
    };

    gallery.addEventListener('click', (event) => {
      const tile = (event.target as HTMLElement).closest<HTMLButtonElement>('.tile');
      if (!tile) return;
      open(Number(tile.dataset.index));
    });

    prevBtn.addEventListener('click', () => show(current - 1));
    nextBtn.addEventListener('click', () => show(current + 1));
    closeBtn.addEventListener('click', close);

    // לחיצה מחוץ לתמונה סוגרת
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog || target.classList.contains('lb__stage')) close();
    });

    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
      image.removeAttribute('src');
      opener?.focus();
    });

    // החלקה במגע במובייל
    let touchX = 0;
    let touchY = 0;
    dialog.addEventListener(
      'touchstart',
      (event) => {
        touchX = event.changedTouches[0].clientX;
        touchY = event.changedTouches[0].clientY;
      },
      { passive: true },
    );
    dialog.addEventListener(
      'touchend',
      (event) => {
        if (single) return;
        const dx = event.changedTouches[0].clientX - touchX;
        const dy = event.changedTouches[0].clientY - touchY;
        if (Math.abs(dx) < 48 || Math.abs(dx) < Math.abs(dy)) return;
        // כיוון RTL: החלקה שמאלה מתקדמת
        show(dx < 0 ? current + 1 : current - 1);
      },
      { passive: true },
    );

    // הגעה מקישור ישיר לעבודה מסוימת (למשל מהעמוד הראשי) פותחת אותה מיד.
    const fromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!id) return;
      const index = items.findIndex((item) => item.button.id === id);
      if (index >= 0) {
        items[index].button.scrollIntoView({ block: 'center', behavior: 'auto' });
        open(index);
      }
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);

    dialog.addEventListener('keydown', (event) => {
      if (single) return;
      // כיוון RTL: חץ שמאלה מתקדם, חץ ימינה חוזר
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(current + 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(current - 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        show(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        show(items.length - 1);
      }
    });
  }
</script>
