---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { about, categories, commission, featured, hero, statement } from '../content/site';
import { featuredWorks, workById } from '../content/works';
import { getAsset } from '../lib/images';
import { withBase } from '../lib/url';

const heroWork = workById(hero.image)!;
const heroImage = getAsset(heroWork.image);

const picks = featuredWorks();
const bandA = picks.slice(0, 2);
const bandB = picks.slice(2, 5);
const bandC = picks.slice(5, 6);

const linkFor = (categoryId: string, workId: string) =>
  withBase(`/${categoryId === 'paintings' ? 'paintings' : 'sculpture'}`) + `#${workId}`;

const categoryCovers = categories.map((c) => {
  const work = workById(c.cover)!;
  return { ...c, work, image: getAsset(work.image) };
});

const portrait = getAsset(about.portrait);
const commissionImage = getAsset(commission.image);
---

<Base>
  {/* ─────────────────────────────── פתיחה ─────────────────────────────── */}
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__inner">
      <div class="hero__text">
        <h1 id="hero-title">{hero.title}</h1>
        <p class="hero__subtitle">{hero.subtitle}</p>
        <p class="hero__lede">{hero.text}</p>
        <div class="hero__actions">
          <a class="btn btn--solid" href={withBase(hero.primaryCta.href)}>{hero.primaryCta.label}</a>
          <a class="btn btn--quiet" href={withBase(hero.secondaryCta.href)}>{hero.secondaryCta.label}</a>
        </div>
      </div>

      <figure class="hero__figure">
        <Image
          src={heroImage}
          alt={heroWork.alt}
          widths={[560, 840, 1200]}
          sizes="(min-width: 1024px) 54vw, 92vw"
          loading="eager"
          fetchpriority="high"
          quality={82}
        />
      </figure>
    </div>
  </section>

  {/* ──────────────────────────── הצהרת אמנית ──────────────────────────── */}
  <section class="section section--tight statement" aria-label="הצהרת האמנית">
    <div class="container--narrow reveal">
      <p class="statement__text">{statement.text}</p>
      <p class="statement__sign">רחל פז אבגיל</p>
    </div>
  </section>

  {/* ─────────────────────────── עבודות נבחרות ─────────────────────────── */}
  <section class="section section--stone" aria-labelledby="featured-title">
    <div class="container">
      <header class="reveal">
        <p class="eyebrow">{featured.eyebrow}</p>
        <h2 id="featured-title">{featured.title}</h2>
      </header>

      <div class="featured">
        <div class="band band--a">
          {
            bandA.map((work, i) => (
              <a
                class={`fw fw--a${i + 1} reveal`}
                style={`--reveal-delay:${i * 90}ms`}
                href={linkFor(work.category, work.id)}
              >
                <Image
                  src={getAsset(work.image)}
                  alt={work.alt}
                  widths={[420, 700, 1000]}
                  sizes="(min-width: 900px) 45vw, (min-width: 640px) 44vw, 88vw"
                  loading="lazy"
                  quality={80}
                />
              </a>
            ))
          }
        </div>

        <div class="band band--b">
          {
            bandB.map((work, i) => (
              <a
                class={`fw fw--b${i + 1} reveal`}
                style={`--reveal-delay:${i * 90}ms`}
                href={linkFor(work.category, work.id)}
              >
                <Image
                  src={getAsset(work.image)}
                  alt={work.alt}
                  widths={[380, 580, 820]}
                  sizes="(min-width: 640px) 30vw, 88vw"
                  loading="lazy"
                  quality={80}
                />
              </a>
            ))
          }
        </div>

        <div class="band band--c">
          {
            bandC.map((work) => (
              <a class="fw fw--c1 reveal" href={linkFor(work.category, work.id)}>
                <Image
                  src={getAsset(work.image)}
                  alt={work.alt}
                  widths={[520, 820, 1100]}
                  sizes="(min-width: 900px) 58vw, (min-width: 640px) 72vw, 88vw"
                  loading="lazy"
                  quality={80}
                />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* ────────────────────────── שתי הקטגוריות ─────────────────────────── */}
  <section class="section" aria-labelledby="categories-title">
    <div class="container">
      <h2 id="categories-title" class="visually-hidden">תחומי היצירה</h2>
      <div class="cats">
        {
          categoryCovers.map((cat, i) => (
            <a class="cat reveal" style={`--reveal-delay:${i * 120}ms`} href={withBase(cat.href)}>
              <span class="cat__media">
                <Image
                  src={cat.image}
                  alt=""
                  widths={[420, 700, 900]}
                  sizes="(min-width: 900px) 31vw, (min-width: 640px) 45vw, 88vw"
                  loading="lazy"
                  quality={78}
                />
              </span>
              <span class="cat__body">
                <h3 class="cat__title">{cat.label}</h3>
                <span class="cat__text">{cat.text}</span>
                <span class="link-arrow" aria-hidden="true">
                  לגלריה
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                    <path
                      d="M15 5l-7 7 7 7"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                    />
                  </svg>
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ────────────────────────────── אודות ─────────────────────────────── */}
  <section class="section section--stone" aria-labelledby="about-title">
    <div class="container about-preview">
      <figure class="about-preview__figure reveal">
        <Image
          src={portrait}
          alt={about.portraitAlt}
          widths={[380, 560, 760]}
          sizes="(min-width: 900px) 38vw, 82vw"
          loading="lazy"
          quality={80}
        />
      </figure>
      <div class="about-preview__body reveal">
        <p class="eyebrow">האמנית</p>
        <h2 id="about-title">{about.title}</h2>
        <p class="lede">{about.paragraphs[0]}</p>
        <a class="link-arrow" href={withBase('/about')}>
          עוד על רחל
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  {/* ──────────────────────── יצירה אישית בהזמנה ──────────────────────── */}
  <section class="section commission" aria-labelledby="commission-title">
    <div class="container commission__inner">
      <div class="commission__body reveal">
        <h2 id="commission-title">{commission.title}</h2>
        <p class="lede">{commission.text}</p>
        <a class="btn btn--solid" href={withBase(commission.cta.href)}>{commission.cta.label}</a>
      </div>
      <figure class="commission__figure reveal">
        <Image
          src={commissionImage}
          alt={commission.imageAlt}
          widths={[360, 540, 720]}
          sizes="(min-width: 900px) 34vw, 78vw"
          loading="lazy"
          quality={78}
        />
      </figure>
    </div>
  </section>
</Base>

<style>
  /* ───────────────────────────── פתיחה ───────────────────────────── */
  .hero {
    padding-block: clamp(2.5rem, 7vw, 6rem) clamp(3rem, 8vw, 7rem);
  }

  .hero__inner {
    display: grid;
    gap: clamp(2.25rem, 5vw, 4.5rem);
    align-items: center;
  }

  .hero__text h1 {
    letter-spacing: -0.015em;
  }

  .hero__subtitle {
    margin-top: 1.1rem;
    font-family: 'Frank Ruhl Libre', Georgia, serif;
    font-size: var(--step-1);
    color: var(--terracotta);
    font-weight: 400;
    line-height: 1.5;
  }

  .hero__lede {
    margin-top: 1.4rem;
    max-width: 46ch;
    color: var(--ink-soft);
    font-size: var(--step-0);
    font-weight: 300;
    line-height: 1.85;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.25rem;
  }

  .hero__figure {
    margin: 0;
  }

  .hero__figure :global(img) {
    width: 100%;
    height: auto;
    box-shadow: var(--shadow-lift);
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
  }

  /* ────────────────────────── הצהרת אמנית ────────────────────────── */
  .statement {
    text-align: center;
  }

  .statement__text {
    font-family: 'Frank Ruhl Libre', Georgia, serif;
    font-size: clamp(1.15rem, 1rem + 0.75vw, 1.55rem);
    line-height: 1.85;
    color: var(--ink);
    font-weight: 400;
  }

  .statement__sign {
    margin-top: 1.75rem;
    font-size: var(--step--1);
    letter-spacing: 0.2em;
    color: var(--ink-muted);
  }

  .statement__sign::before {
    content: '';
    display: block;
    width: 2.5rem;
    height: 1px;
    background: var(--line);
    margin: 0 auto 1.25rem;
  }

  /* ───────────────────────── עבודות נבחרות ───────────────────────── */
  .featured {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .band {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3.5rem);
  }

  .fw {
    display: block;
    text-decoration: none;
  }

  .fw :global(img) {
    width: 100%;
    height: auto;
    box-shadow: var(--shadow-soft);
    transition: box-shadow 0.5s var(--ease), transform 0.6s var(--ease);
  }

  .fw:hover :global(img),
  .fw:focus-visible :global(img) {
    box-shadow: var(--shadow-lift);
    transform: translateY(-3px);
  }

  @media (min-width: 640px) {
    .band--a {
      grid-template-columns: repeat(12, 1fr);
      align-items: end;
    }

    .fw--a1 {
      grid-column: 1 / span 7;
    }

    .fw--a2 {
      grid-column: 9 / span 4;
    }

    .band--b {
      grid-template-columns: repeat(12, 1fr);
      align-items: start;
    }

    .fw--b1 {
      grid-column: 1 / span 4;
      margin-top: clamp(1rem, 3vw, 3.5rem);
    }

    .fw--b2 {
      grid-column: 5 / span 4;
    }

    .fw--b3 {
      grid-column: 9 / span 4;
      margin-top: clamp(1.5rem, 4vw, 5rem);
    }

    .band--c {
      grid-template-columns: repeat(12, 1fr);
    }

    .fw--c1 {
      grid-column: 2 / span 9;
    }
  }

  @media (min-width: 900px) {
    .fw--c1 {
      grid-column: 3 / span 7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fw:hover :global(img),
    .fw:focus-visible :global(img) {
      transform: none;
    }
  }

  /* ────────────────────────── שתי הקטגוריות ─────────────────────── */
  .cats {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .cats {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .cat {
    display: grid;
    gap: 1.5rem;
    text-decoration: none;
    align-content: start;
  }

  .cat__media {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .cat__media :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: var(--shadow-soft);
    transition: transform 0.7s var(--ease);
  }

  .cat:hover .cat__media :global(img),
  .cat:focus-visible .cat__media :global(img) {
    transform: scale(1.025);
  }

  .cat__body {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }

  .cat__title {
    font-size: var(--step-2);
  }

  .cat__text {
    color: var(--ink-soft);
    max-width: 42ch;
    font-weight: 300;
  }

  .cat .link-arrow {
    margin-top: 0.35rem;
  }

  .cat:hover .link-arrow {
    color: var(--terracotta);
    border-bottom-color: currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .cat:hover .cat__media :global(img) {
      transform: none;
    }
  }

  /* ───────────────────────────── אודות ──────────────────────────── */
  .about-preview {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .about-preview__figure {
    margin: 0;
  }

  .about-preview__figure :global(img) {
    width: 100%;
    height: auto;
    box-shadow: var(--shadow-lift);
  }

  .about-preview__body {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
  }

  .about-preview__body h2 {
    margin-bottom: 0.3rem;
  }

  @media (min-width: 900px) {
    .about-preview {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    }
  }

  /* ──────────────────────── יצירה בהזמנה ────────────────────────── */
  .commission__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .commission__body {
    display: grid;
    justify-items: start;
    gap: 1.4rem;
  }

  .commission__figure {
    margin: 0;
  }

  .commission__figure :global(img) {
    width: 100%;
    height: auto;
    box-shadow: var(--shadow-lift);
  }

  @media (min-width: 900px) {
    .commission__inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }
  }
</style>
