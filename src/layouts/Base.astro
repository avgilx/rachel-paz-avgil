---
import '@fontsource/frank-ruhl-libre/hebrew-400.css';
import '@fontsource/frank-ruhl-libre/hebrew-500.css';
import '@fontsource-variable/heebo';
import '../styles/global.css';

// טעינה מוקדמת של תת־הקבוצה העברית — מונעת קפיצת פריסה כשהגופן מחליף את גופן הגיבוי.
import frank400 from '@fontsource/frank-ruhl-libre/files/frank-ruhl-libre-hebrew-400-normal.woff2?url';
import frank500 from '@fontsource/frank-ruhl-libre/files/frank-ruhl-libre-hebrew-500-normal.woff2?url';
import heeboHebrew from '@fontsource-variable/heebo/files/heebo-hebrew-wght-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../content/site';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** קובץ כרטיס שיתוף מתוך public/ — 1200×630 */
  ogImage?: string;
}

const {
  title = site.seoTitle,
  description = site.seoDescription,
  ogImage = '/og-default.jpg',
} = Astro.props;

const canonical = Astro.site
  ? new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site).href
  : undefined;
const homeUrl = Astro.site ? new URL(withBase('/'), Astro.site).href : undefined;
const ogUrl = canonical;
const ogPath = withBase(ogImage);
const ogImageUrl = Astro.site ? new URL(ogPath, Astro.site).href : ogPath;

// נתוני structured data — רק פרטים אמיתיים.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'אמנית',
  description: site.seoDescription,
  knowsAbout: ['ציור בשמן', 'פיסול', 'אמנות יהודית'],
  ...(homeUrl ? { url: homeUrl } : {}),
};
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site.noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#faf7f1" />

    <link rel="preload" as="font" type="font/woff2" href={heeboHebrew} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={frank500} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={frank400} crossorigin="anonymous" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={site.locale} />
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`עבודה של ${site.name}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} is:inline />
  </head>

  <body>
    <a class="skip-link" href="#main">דילוג לתוכן הראשי</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // הופעה עדינה בגלילה — רק אם המשתמש לא ביקש להפחית תנועה.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll<HTMLElement>('.reveal');

      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.06 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
